### 6) SOAP V3 with traceparent (Camel spring-ws: entry point into direct:get-country)
< {%
    if (!client.global.get("traceId")) {
        throw new Error("traceId is not set - run step 2 first");
    }
    const hex = (length) => Array.from({ length: length },
        () => "0123456789abcdef"[Math.floor(Math.random() * 16)]).join("");
    client.global.set("spanId", hex(16));
%}
POST http://localhost:{{application-port}}/services
Content-Type: text/xml; charset=utf-8
SOAPAction: ""
traceparent: 00-{{traceId}}-{{spanId}}-01
baggage: testBaggage=hallo

< ../getCountryRequestV3.xml

> {%
    const traceId = client.global.get("traceId");
    const body = String(response.body);
    client.test("returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("returns the V3 response", function () {
        client.assert(/<([\w-]+:)?getCountryResponseV3[\s>]/.test(body), "getCountryResponseV3 missing");
        client.assert(/<([\w-]+:)?name>Spain</.test(body), "name=Spain missing");
        client.assert(/<([\w-]+:)?currency>EUR</.test(body), "currency=EUR missing");
    });
    client.test("echoes traceparent and baggage in the SOAP header", function () {
        client.assert(body.includes('traceparent="00-' + traceId + "-"),
            "SOAP header traceparent does not carry the incoming traceId");
        client.assert(body.includes('baggage="'), "SOAP header baggage missing");
    });
    client.test("does not overwrite the incoming traceparent", function () {
        client.assert(!response.headers.valueOf("traceparent"), "unexpected response traceparent");
    });
%}

