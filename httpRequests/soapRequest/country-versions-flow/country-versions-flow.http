%}

### 8) verify the recorded V1/V2/V3 exchanges (actuator/httpexchanges) — requires steps 2, 4 and 6
< {%
    if (!client.global.get("traceId")) {
        throw new Error("traceId is not set - run step 2 first");
    }
%}
GET http://localhost:{{application-port}}/actuator/httpexchanges
Accept: application/json

> {%
    const traceId = client.global.get("traceId");
    client.test("returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("records one /services exchange per variant for the shared traceId", function () {
        const matches = (response.body.exchanges || []).filter(function (exchange) {
            const uri = exchange.request && exchange.request.uri ? exchange.request.uri : "";
            return uri.includes("/services") && JSON.stringify(exchange.request.headers || {}).includes(traceId);
        });
        client.assert(matches.length === 3, "expected 3 exchanges for the traceId but got " + matches.length);
        matches.forEach(function (exchange) {
            client.assert(String(exchange.response.status) === "200",
                "unexpected status " + exchange.response.status);
        });
    });
%}
